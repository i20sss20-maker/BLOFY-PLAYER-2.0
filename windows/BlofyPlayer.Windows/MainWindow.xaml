<Window x:Class="BlofyPlayer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="BLOFY PLAYER" Width="1500" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FlowDirection="RightToLeft">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="18"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="22" Padding="16">
      <StackPanel>
        <TextBlock Text="BLOFY" Foreground="{StaticResource Purple}" FontWeight="Bold" FontSize="28" Margin="0,8,0,22" HorizontalAlignment="Center"/>
        <Button x:Name="LiveNav" Content="البث المباشر" Height="54" Margin="0,4" Click="LiveNav_Click"/>
        <Button x:Name="MoviesNav" Content="الأفلام" Height="54" Margin="0,4" Click="MoviesNav_Click"/>
        <Button x:Name="SeriesNav" Content="المسلسلات" Height="54" Margin="0,4" Click="SeriesNav_Click"/>
        <Button Content="تحديث القائمة" Height="54" Margin="0,4" Click="Refresh_Click"/>
        <Button Content="إعدادات الاتصال" Height="54" Margin="0,4" Click="ShowLogin_Click"/>
        <TextBlock Text="Windows Preview 01" Foreground="{StaticResource Muted}" Margin="0,28,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right">
          <TextBlock Text="BLOFY PLAYER" Foreground="{StaticResource Purple}" FontWeight="Bold" FontSize="14"/>
          <TextBlock x:Name="SectionTitle" Text="جاهز للمشاهدة" Foreground="{StaticResource Text}" FontWeight="Bold" FontSize="31"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Text="أضف بيانات السيرفر للبدء"/>
      </DockPanel>

      <Grid Grid.Row="1">
        <Grid x:Name="LoginPanel">
          <Border Background="{StaticResource Panel}" CornerRadius="24" Padding="34" MaxWidth="760" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="إضافة قائمة Xtream" Foreground="{StaticResource Text}" FontWeight="Bold" FontSize="28" Margin="0,0,0,8"/>
              <TextBlock Text="بياناتك تُحفظ محليًا على هذا الكمبيوتر" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,24"/>
              <TextBlock Text="رابط السيرفر" Foreground="{StaticResource Muted}"/>
              <TextBox x:Name="ServerBox" Height="44" Margin="0,6,0,14" FontSize="16" Padding="10"/>
              <TextBlock Text="اسم المستخدم" Foreground="{StaticResource Muted}"/>
              <TextBox x:Name="UsernameBox" Height="44" Margin="0,6,0,14" FontSize="16" Padding="10"/>
              <TextBlock Text="كلمة المرور" Foreground="{StaticResource Muted}"/>
              <PasswordBox x:Name="PasswordBox" Height="44" Margin="0,6,0,20" FontSize="16" Padding="10"/>
              <Button Content="اتصال وتحميل القوائم" Height="52" FontWeight="Bold" Click="Connect_Click"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="BrowserPanel" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="20" Padding="10">
            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" FontSize="15" SelectionChanged="CategoryList_SelectionChanged"/>
          </Border>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="300"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Panel}" CornerRadius="20" Padding="10">
              <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" FontSize="15" MouseDoubleClick="ItemList_MouseDoubleClick"/>
            </Border>
            <Border Grid.Row="1" Background="#000000" CornerRadius="20" Margin="0,14,0,0" ClipToBounds="True">
              <vlc:VideoView x:Name="VideoView"/>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
