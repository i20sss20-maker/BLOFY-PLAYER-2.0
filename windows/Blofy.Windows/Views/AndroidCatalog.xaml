<!-- PosterCatalogActivity / PosterStreamAdapter at dc0b0c84d7dd5973e8d0426f16793f14b9b06417. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <LinearGradientBrush x:Key="CatalogRailBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#E81A1429" Offset="0"/><GradientStop Color="#F00C0A15" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="PosterBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#ED181321" Offset="0"/><GradientStop Color="#F00C0A12" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="PosterFocusedBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5D2498" Offset="0"/><GradientStop Color="#241330" Offset="1"/></LinearGradientBrush>
  <Style x:Key="PosterButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PosterBrush}"/><Setter Property="BorderBrush" Value="#554D376B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="7,7,7,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" RenderTransformOrigin="0.5,0.5"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource PosterFocusedBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="#E0B5FF"/><Setter TargetName="Card" Property="BorderThickness" Value="3"/><Setter TargetName="Card" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.035" ScaleY="1.035"/></Setter.Value></Setter></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#E0B5FF"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="AndroidCatalogView">
    <Grid Margin="28,22,28,24" FlowDirection="LeftToRight" KeyboardNavigation.DirectionalNavigation="Contained">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" FontSize="14" Foreground="#C387FF" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold" Style="{StaticResource HomeText}"/></DockPanel>
        <!-- The outer list virtualizes rows, while every realized row has exactly five cells. -->
        <ListBox x:Name="PosterRows" Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Padding="4,4,8,22" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" Focusable="False">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Items}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Button Margin="3,0" Style="{StaticResource PosterButton}" Command="{Binding OpenCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
              <StackPanel>
                <Grid Height="245" Background="#140F1F"><Image Source="{Binding Artwork}" Stretch="UniformToFill"/><Border Background="#E13E1B69" BorderBrush="#BD81FF" BorderThickness="1" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4" Margin="0,8,8,0" Visibility="{Binding HasRating, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding RatingText}" Foreground="White" FontSize="11"/></Border></Grid>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="White" Height="48" Padding="4,9,4,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Metadata}" FontSize="11" Foreground="#B7A8C9" Height="27" Padding="4,2,4,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Border Grid.Column="2" Background="{StaticResource CatalogRailBrush}" CornerRadius="20" BorderBrush="#594A355F" BorderThickness="1" Padding="10,14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="الفئات" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <ListBox x:Name="CategoryList" Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" FlowDirection="RightToLeft" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Padding="12,15"/></DataTemplate></ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,3"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RailItem" CornerRadius="14" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RailItem" Property="Background" Value="#36224F"/><Setter TargetName="RailItem" Property="BorderBrush" Value="#B067FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RailItem" Property="BorderBrush" Value="#E0B5FF"/><Setter TargetName="RailItem" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
