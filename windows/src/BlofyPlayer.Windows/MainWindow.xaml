<Window x:Class="BlofyPlayer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BLOFY PLAYER"
        Width="1440" Height="860"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#08060D"
        Foreground="#F3F4F6"
        FlowDirection="RightToLeft"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <RadialGradientBrush Center="0.82,0.12" GradientOrigin="0.82,0.12" RadiusX="0.98" RadiusY="0.98">
                <GradientStop Color="#241536" Offset="0"/>
                <GradientStop Color="#100A18" Offset="0.42"/>
                <GradientStop Color="#08060D" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder" Grid.Column="0"
                    Background="#E6241536"
                    BorderBrush="#66FFFFFF" BorderThickness="1"
                    CornerRadius="18" Padding="8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10">
                        <Image Source="/Assets/blofy_logo.png"
                               Width="92" Height="54" Stretch="Uniform"
                               HorizontalAlignment="Center" Margin="0,2,0,12"/>
                    </StackPanel>

                    <StackPanel x:Name="NavigationPanel" DockPanel.Dock="Top">
                        <Button Style="{StaticResource NavButton}" Content="⌂  الرئيسية" Tag="home" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="●  البث المباشر" Tag="live" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▣  الأفلام" Tag="movie" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▤  المسلسلات" Tag="series" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◫  المجموعات" Tag="collections" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="★  المفضلة" Tag="favorites" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌕  البحث" Tag="search" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙  الإعدادات" Tag="settings" Click="Nav_Click"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Margin="3,12,3,3" Padding="12"
                            CornerRadius="13" Background="#B3180F23"
                            BorderBrush="#3AFFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الملف الحالي" FontSize="10" Foreground="#9F93AE"/>
                            <TextBlock x:Name="ActiveProfileText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#D0B2FF" Margin="0,2,0,7"/>
                            <TextBlock Text="رقم الجهاز" FontSize="10" Foreground="#9F93AE"/>
                            <TextBlock x:Name="DeviceIdText" FontSize="12" FontWeight="Bold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,3,0,4"/>
                            <TextBlock x:Name="ActivationStatusText" Text="جاري التحقق…" FontSize="10.5"
                                       Foreground="#C9BCD9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="BLOFY PLAYER"
                                   Foreground="#F3F4F6" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitle" Text="اليوم"
                                   Foreground="#C9BCD9" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="HeaderServerText" Grid.Column="1"
                               Foreground="#AFA4BC" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressText" Foreground="#AFA4BC"
                                   FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="HeaderClockText" Foreground="#DDD5E6"
                                   FontSize="10.5" VerticalAlignment="Center" TextAlignment="Left"
                                   FlowDirection="LeftToRight" Margin="0,0,12,0"/>
                        <Button Content="↻" Width="36" Height="34" ToolTip="تحديث المحتوى"
                                Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="12,4,12,6"/>
            </Grid>
        </Grid>

        <Grid x:Name="OverlayHost"
              Panel.ZIndex="100"
              Background="#F208060D"
              Visibility="Collapsed">
            <ContentControl x:Name="OverlayContent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>