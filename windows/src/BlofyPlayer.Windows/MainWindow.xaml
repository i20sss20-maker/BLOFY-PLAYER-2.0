<Window x:Class="BlofyPlayer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="BLOFY PLAYER"
        Width="1366"
        Height="820"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E8E5EF" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,12">
                    <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource PurpleBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="B" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BLOFY PLAYER" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,12,0,2"/>
                    <TextBlock Text="Windows" Foreground="#7B7289" FontSize="13"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Button Style="{StaticResource NavButton}" Content="⌂  الرئيسية" Tag="الرئيسية" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="●  البث المباشر" Tag="البث المباشر" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▣  الأفلام" Tag="الأفلام" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▤  المسلسلات" Tag="المسلسلات" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="★  المفضلة" Tag="المفضلة" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⌕  البحث" Tag="البحث" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙  الإعدادات" Tag="الإعدادات" Click="Nav_Click"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="14" Padding="14" CornerRadius="14" Background="#F3EEFF">
                    <StackPanel>
                        <TextBlock Text="رقم الجهاز" FontSize="12" Foreground="#766D83"/>
                        <TextBlock x:Name="DeviceIdText" FontWeight="Bold" FontSize="15" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,4,0,8"/>
                        <TextBlock x:Name="ActivationStatusText" Text="جاري التحقق من التفعيل…" Foreground="{StaticResource PurpleDarkBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="BLOFY PLAYER • نسخة Windows" Foreground="#7B7289" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="16" Padding="16,10" Background="White" BorderBrush="#E8E5EF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#22C55E" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TopStatusText" Text="جاهز" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="24" Background="#17151D" Padding="2">
                            <Grid>
                                <vlc:VideoView x:Name="VideoView" Height="330"/>
                                <Border VerticalAlignment="Bottom" Margin="18" Padding="14,9" Background="#99000000" CornerRadius="12">
                                    <TextBlock Text="المعاينة المباشرة • محرك LibVLC" Foreground="White" FontSize="14"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" CornerRadius="24" Background="White" BorderBrush="#E8E5EF" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <TextBlock Text="نسخة ويندوز" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="نفس حساب BLOFY PLAYER ونفس التفعيل ونفس قوائمك، مع تشغيل مخصص لويندوز." TextWrapping="Wrap" Foreground="#6D647A" Margin="0,10,0,18"/>
                                <TextBlock Text="كود التفعيل" Foreground="#786F83" FontSize="12"/>
                                <TextBlock x:Name="ActivationCodeText" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PurpleBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                <Button x:Name="RefreshActivationButton" Style="{StaticResource PrimaryButton}" Content="تحديث حالة التفعيل" Margin="0,22,0,0" Click="RefreshActivation_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="الأقسام" FontSize="22" FontWeight="Bold" Margin="0,28,0,14"/>

                    <WrapPanel>
                        <Border Width="220" Height="118" Margin="0,0,14,14" Padding="18" Background="White" CornerRadius="18" BorderBrush="#E8E5EF" BorderThickness="1">
                            <StackPanel><TextBlock Text="●" Foreground="{StaticResource PurpleBrush}" FontSize="26"/><TextBlock Text="البث المباشر" FontWeight="Bold" FontSize="17" Margin="0,8,0,0"/></StackPanel>
                        </Border>
                        <Border Width="220" Height="118" Margin="0,0,14,14" Padding="18" Background="White" CornerRadius="18" BorderBrush="#E8E5EF" BorderThickness="1">
                            <StackPanel><TextBlock Text="▣" Foreground="{StaticResource PurpleBrush}" FontSize="26"/><TextBlock Text="الأفلام" FontWeight="Bold" FontSize="17" Margin="0,8,0,0"/></StackPanel>
                        </Border>
                        <Border Width="220" Height="118" Margin="0,0,14,14" Padding="18" Background="White" CornerRadius="18" BorderBrush="#E8E5EF" BorderThickness="1">
                            <StackPanel><TextBlock Text="▤" Foreground="{StaticResource PurpleBrush}" FontSize="26"/><TextBlock Text="المسلسلات" FontWeight="Bold" FontSize="17" Margin="0,8,0,0"/></StackPanel>
                        </Border>
                        <Border Width="220" Height="118" Margin="0,0,14,14" Padding="18" Background="White" CornerRadius="18" BorderBrush="#E8E5EF" BorderThickness="1">
                            <StackPanel><TextBlock Text="★" Foreground="{StaticResource PurpleBrush}" FontSize="26"/><TextBlock Text="المفضلة" FontWeight="Bold" FontSize="17" Margin="0,8,0,0"/></StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
