<Window x:Class="BlofyPlayer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BLOFY PLAYER"
        Width="1440" Height="860"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FlowDirection="RightToLeft"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#100A18" BorderBrush="#332E203D" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="15,20,15,8">
                    <Border Width="48" Height="48" CornerRadius="14" Background="#D0B2FF" HorizontalAlignment="Right">
                        <TextBlock Text="B" Foreground="#08060D" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BLOFY PLAYER" FontSize="17" FontWeight="Bold" Margin="0,10,0,2"/>
                    <TextBlock Text="Windows" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>

                <StackPanel x:Name="NavigationPanel" DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavButton}" Content="⌂  الرئيسية" Tag="home" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="●  البث المباشر" Tag="live" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▣  الأفلام" Tag="movie" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▤  المسلسلات" Tag="series" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="★  المفضلة" Tag="favorites" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⌕  البحث" Tag="search" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="☰  القوائم" Tag="providers" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙  الإعدادات" Tag="settings" Click="Nav_Click"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" CornerRadius="12"
                        Background="#241536" BorderBrush="#443D2756" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="رقم الجهاز" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="DeviceIdText" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,3,0,5"/>
                        <TextBlock x:Name="ActivationStatusText" Text="جاري التحقق…" FontSize="11" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,10,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="25" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="BLOFY PLAYER" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="↻ تحديث" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="28,12,28,24"/>
        </Grid>
    </Grid>
</Window>
