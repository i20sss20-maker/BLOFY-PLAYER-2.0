<Window x:Class="BlofyPlayer.Windows.EpisodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BLOFY SERIES"
        Width="1160" Height="720"
        MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#08060D"
        Foreground="#F3F4F6"
        FlowDirection="RightToLeft"
        KeyDown="Window_KeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="112"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#241536" BorderBrush="#52FFFFFF"
                BorderThickness="1" CornerRadius="16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="132" Height="78" CornerRadius="10" Background="#180F23"
                        BorderBrush="#52FFFFFF" BorderThickness="1" ClipToBounds="True">
                    <Image x:Name="SeriesArt" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="BLOFY SERIES" Foreground="#D0B2FF"
                               FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="SeriesTitle" FontSize="24" FontWeight="Bold"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" Foreground="#C9BCD9"
                               FontSize="11.5" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="3" Content="↻ إعادة التحميل" x:Name="RetryButton"
                        Visibility="Collapsed" Click="RetryButton_Click"
                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SeasonList" Grid.Column="0"
                     Style="{StaticResource TvListBox}"
                     SelectionChanged="SeasonList_SelectionChanged"/>

            <Border Grid.Column="2" Background="#160D22"
                    BorderBrush="#52FFFFFF" BorderThickness="1"
                    CornerRadius="14" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="EpisodePanel"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>