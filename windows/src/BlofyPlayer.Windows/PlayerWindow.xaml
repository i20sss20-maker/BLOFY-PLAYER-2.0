<Window x:Class="BlofyPlayer.Windows.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="BLOFY PLAYER"
        Width="1280" Height="760"
        MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="#050408"
        Foreground="#F3F4F6"
        KeyDown="Window_KeyDown"
        FlowDirection="RightToLeft">
    <Grid>
        <vlc:VideoView x:Name="VideoView"/>

        <Border x:Name="Hud" VerticalAlignment="Bottom" Margin="24" Padding="18"
                CornerRadius="16" Background="#D908060D" BorderBrush="#665E437A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="TimeText" HorizontalAlignment="Left" FlowDirection="LeftToRight" Foreground="#C9BCD9"/>
                </Grid>

                <Slider x:Name="SeekSlider" Grid.Row="1" Margin="0,12,0,10" Minimum="0" Maximum="1"
                        PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="PlayPauseButton" Content="⏯  تشغيل/إيقاف" Click="PlayPause_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="⏪ 10ث" Click="Back_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="10ث ⏩" Click="Forward_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="🔊 صوت" Click="Audio_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="CC ترجمة" Click="Subtitle_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="⛶ ملء الشاشة" Click="Fullscreen_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="إغلاق" Click="Close_Click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
