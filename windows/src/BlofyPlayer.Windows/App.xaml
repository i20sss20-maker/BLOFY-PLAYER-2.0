<Application x:Class="BlofyPlayer.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="CinemaBackground">#08060D</Color>
        <Color x:Key="CinemaSurface">#241536</Color>
        <Color x:Key="CinemaWhite">#F3F4F6</Color>
        <Color x:Key="CinemaMuted">#C9BCD9</Color>
        <Color x:Key="CinemaAccent">#D0B2FF</Color>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource CinemaBackground}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource CinemaSurface}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource CinemaWhite}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource CinemaMuted}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CinemaAccent}"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#241536"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9BCD9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="7,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#D0B2FF"/>
            <Setter Property="Foreground" Value="#08060D"/>
            <Setter Property="BorderBrush" Value="#EBD8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#241536"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#665E437A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#180F23"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#665E437A"/>
            <Setter Property="CaretBrush" Value="#D0B2FF"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#180F23"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#665E437A"/>
            <Setter Property="CaretBrush" Value="#D0B2FF"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#241536"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#665E437A"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Application.Resources>
</Application>
