<Application x:Class="BlofyPlayer.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="BlofyPurple">#6D28D9</Color>
        <Color x:Key="BlofyPurpleDark">#4C1D95</Color>
        <Color x:Key="BlofySurface">#F7F7FB</Color>
        <Color x:Key="BlofyText">#17151D</Color>
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource BlofyPurple}"/>
        <SolidColorBrush x:Key="PurpleDarkBrush" Color="{StaticResource BlofyPurpleDark}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource BlofySurface}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource BlofyText}"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2E2938"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
