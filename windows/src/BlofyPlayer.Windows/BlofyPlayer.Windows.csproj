<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>BLOFY PLAYER</AssemblyName>
    <RootNamespace>BlofyPlayer.Windows</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.4.7</Version>
    <AssemblyVersion>0.4.7.0</AssemblyVersion>
    <FileVersion>0.4.7.0</FileVersion>
    <Product>BLOFY PLAYER</Product>
    <Company>BLOFY</Company>
    <Authors>BLOFY</Authors>
    <Description>BLOFY PLAYER for Windows</Description>
    <ApplicationIcon Condition="Exists('Assets\blofy.ico')">Assets\blofy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\..\app\src\main\res\drawable-nodpi\blofy_logo.png">
      <Link>Assets\blofy_logo.png</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
</Project>
