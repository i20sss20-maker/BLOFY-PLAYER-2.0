<UserControl x:Class="BlofyPlayer.Windows.EpisodesOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#08060D"
        Foreground="#F3F4F6"
        FlowDirection="RightToLeft"
        Focusable="True"
        PreviewKeyDown="Overlay_KeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="112"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#241536" BorderBrush="#52FFFFFF"
                BorderThickness="1" CornerRadius="16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="132" Height="78" CornerRadius="10"
                        Background="#180F23" BorderBrush="#52FFFFFF"
                        BorderThickness="1" ClipToBounds="True">
                    <Image x:Name="SeriesArt" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="BLOFY SERIES" Foreground="#D0B2FF"
                               FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="SeriesTitle" FontSize="24" FontWeight="Bold"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" Foreground="#C9BCD9"
                               FontSize="11.5" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RetryButton" Content="↻ إعادة التحميل"
                            Visibility="Collapsed" Click="RetryButton_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="← رجوع" Click="BackButton_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SeasonList" Grid.Column="0"
                     Style="{StaticResource TvListBox}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="SeasonList_SelectionChanged"/>

            <Border Grid.Column="2" Background="#160D22"
                    BorderBrush="#52FFFFFF" BorderThickness="1"
                    CornerRadius="14" Padding="10">
                <ScrollViewer x:Name="EpisodeScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel x:Name="EpisodePanel"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>