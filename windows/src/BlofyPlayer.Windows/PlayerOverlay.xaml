<UserControl x:Class="BlofyPlayer.Windows.PlayerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Background="Black"
        Foreground="#F3F4F6"
        Focusable="True"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Overlay_KeyDown"
        MouseMove="Overlay_MouseMove"
        MouseDoubleClick="Overlay_MouseDoubleClick">
    <UserControl.Resources>
        <Style x:Key="PlayerRoundButton" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Background" Value="#CC241536"/>
            <Setter Property="BorderBrush" Value="#665E437A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#63408A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#EBD8FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#63408A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PlayerRoundButton}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Background" Value="#D0B2FF"/>
            <Setter Property="Foreground" Value="#08060D"/>
            <Setter Property="BorderBrush" Value="#F6ECFF"/>
        </Style>
        <Style x:Key="PlayerPillButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="94"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="#E8E0EF"/>
            <Setter Property="Background" Value="#AA180F23"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3D2756"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#EBD8FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#63408A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PlayerRoot" Background="Black">
        <!-- LibVLC WPF uses a native WinForms HWND. Sibling WPF controls are
             ALWAYS hidden behind video in fullscreen (airspace limitation).
             VideoView.Content creates the supported independent overlay HWND;
             playback controls now stay visible and clickable over real video. -->
        <vlc:VideoView x:Name="VideoView"
                       Background="Black"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch">
            <Grid x:Name="VideoOverlaySurface"
                  Background="#01000000"
                  Focusable="True"
                  FlowDirection="LeftToRight"
                  PreviewKeyDown="Overlay_KeyDown"
                  MouseMove="Overlay_MouseMove"
                  MouseDoubleClick="Overlay_MouseDoubleClick">

        <!-- Keep a failed native video surface from leaving a white desktop pane. -->
        <Border x:Name="PlaybackFailureShade"
                Background="#F008060D"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Panel.ZIndex="5"/>

        <Border x:Name="LoadingBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#D908060D"
                BorderBrush="#665E437A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22,14"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="44" Height="5"
                             IsIndeterminate="True"
                             Foreground="#D0B2FF"
                             Background="#241536"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                <TextBlock x:Name="LoadingText"
                           Text="جاري التشغيل…"
                           Foreground="#F3F4F6"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Button x:Name="RetryPlaybackButton"
                Content="↻ إعادة المحاولة"
                Click="RetryPlayback_Click"
                Style="{StaticResource PlayerPillButton}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,100,0,0"
                MinWidth="170"
                Height="46"
                FontSize="15"
                Panel.ZIndex="40"
                Visibility="Collapsed"/>

        <StackPanel x:Name="PersistentTopControls"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20"
                    Panel.ZIndex="30"
                    FlowDirection="RightToLeft">
            <Button x:Name="PersistentBackButton"
                    Content="← رجوع"
                    Click="Close_Click"
                    Style="{StaticResource PlayerPillButton}"
                    MinWidth="92"
                    Height="42"/>
            <Button x:Name="PersistentPlayPauseButton"
                    Content="⏸ إيقاف مؤقت"
                    Click="PlayPause_Click"
                    Style="{StaticResource PlayerPillButton}"
                    MinWidth="120"
                    Height="42"/>
            <Button x:Name="PersistentFullscreenButton"
                    Content="🗗 نافذة"
                    Click="Fullscreen_Click"
                    Style="{StaticResource PlayerPillButton}"
                    MinWidth="92"
                    Height="42"/>
            <Button x:Name="ChannelListButton"
                    Content="☰ القنوات"
                    Click="ChannelList_Click"
                    Style="{StaticResource PlayerPillButton}"
                    MinWidth="104"
                    Height="42"/>
            <Button x:Name="LastChannelButton"
                    Content="↩ آخر قناة"
                    Click="LastChannel_Click"
                    Style="{StaticResource PlayerPillButton}"
                    MinWidth="104"
                    Height="42"/>
        </StackPanel>

        <Border x:Name="TopShade" VerticalAlignment="Top" Height="96"
                Background="#8A08060D" IsHitTestVisible="False">
            <Grid Margin="28,16">
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="BLOFY PLAYER" FontSize="9.5" FontWeight="Bold"
                               Foreground="#D0B2FF"/>
                    <TextBlock x:Name="TopTitleText" FontSize="17" FontWeight="SemiBold"
                               Foreground="#F3F4F6" Margin="0,4,0,0"
                               MaxWidth="900" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ChannelPanel"
                Width="390"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="20,92,20,24"
                Background="#F20B0810"
                BorderBrush="#665E437A"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14"
                Panel.ZIndex="25"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="4,0,4,12">
                    <TextBlock Text="BLOFY LIVE"
                               Foreground="#D0B2FF"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock Text="القنوات"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <ListBox x:Name="ChannelList"
                         Grid.Row="1"
                         Style="{StaticResource TvListBox}"
                         DisplayMemberPath="Display"
                         PreviewKeyDown="ChannelList_KeyDown"
                         SelectionChanged="ChannelList_SelectionChanged"/>
                <TextBlock x:Name="ChannelListHint"
                           Grid.Row="2"
                           Text="↑↓ تنقل   •   OK تشغيل   •   رجوع إغلاق"
                           Foreground="#AFA4BC"
                           FontSize="10.5"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Border x:Name="ChannelNumberBadge"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="28,118,0,0"
                Background="#DD08060D"
                BorderBrush="#66D0B2FF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,10"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="ChannelNumberText"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#F3F4F6"
                       FlowDirection="LeftToRight"/>
        </Border>

        <Border x:Name="Hud"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                KeyboardNavigation.TabNavigation="Cycle"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="24" Padding="18,14"
                CornerRadius="18" Background="#E308060D"
                BorderBrush="#665E437A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"
                                   MaxWidth="900" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EpgText" FontSize="12.5" Foreground="#DDD3E9"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   MaxWidth="1050"/>
                    </StackPanel>
                    <TextBlock x:Name="TimeText" HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               FlowDirection="LeftToRight" Foreground="#C9BCD9"
                               FontSize="10.5"/>
                </Grid>

                <Slider x:Name="SeekSlider" Grid.Row="1"
                        Minimum="0" Maximum="1" Height="20"
                        Margin="0,8,0,6"
                        PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,9">
                    <Button x:Name="PreviousButton" Content="⏮"
                            Click="Previous_Click" Style="{StaticResource PlayerRoundButton}"
                            ToolTip="السابق"/>
                    <Button x:Name="RewindButton" Content="↶10"
                            Click="Rewind_Click" Style="{StaticResource PlayerRoundButton}"
                            FontSize="13" ToolTip="رجوع 10 ثوان"/>
                    <Button x:Name="PlayPauseButton" Content="⏸"
                            Click="PlayPause_Click" Style="{StaticResource PlayerPrimaryButton}"
                            ToolTip="تشغيل / إيقاف"/>
                    <Button x:Name="Forward10Button" Content="10↷"
                            Click="Forward10_Click" Style="{StaticResource PlayerRoundButton}"
                            FontSize="13" ToolTip="تقديم 10 ثوان"/>
                    <Button x:Name="NextButton" Content="⏭"
                            Click="Next_Click" Style="{StaticResource PlayerRoundButton}"
                            ToolTip="التالي"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="AudioButton" Content="🔊 الصوت" Click="Audio_Click"
                            Style="{StaticResource PlayerPillButton}"/>
                    <Button x:Name="SubtitleButton" Content="CC الترجمة" Click="Subtitle_Click"
                            Style="{StaticResource PlayerPillButton}"/>
                    <Button x:Name="QualityButton" Content="◉ الجودة" Click="Quality_Click"
                            Style="{StaticResource PlayerPillButton}"/>
                    <Button x:Name="AspectButton" Content="▣ المقاس" Click="Aspect_Click"
                            Style="{StaticResource PlayerPillButton}"/>
                    <Button x:Name="FavoriteButton" Content="☆ المفضلة"
                            Click="Favorite_Click"
                            Style="{StaticResource PlayerPillButton}"/>
                    <Button x:Name="FullscreenButton" Content="⛶ الشاشة"
                            Click="Fullscreen_Click"
                            Style="{StaticResource PlayerPillButton}"/>
                    <Button x:Name="CloseButton" Content="✕ رجوع" Click="Close_Click"
                            Style="{StaticResource PlayerPillButton}"/>
                </StackPanel>
            </Grid>
        </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</UserControl>