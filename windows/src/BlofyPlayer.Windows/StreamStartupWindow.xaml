<Window x:Class="BlofyPlayer.Windows.StreamStartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BLOFY STREAM" Width="1130" Height="725"
        MinWidth="730" MinHeight="555" WindowStartupLocation="CenterScreen"
        Background="#0A0710" Foreground="#F9F7FC"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="StreamButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7847BA"/>
            <Setter Property="BorderBrush" Value="#A982D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Background" Value="#9E6BE2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9E6BE2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.75,0.08" GradientOrigin="0.75,0.08" RadiusX="0.95" RadiusY="1.0">
                <GradientStop Color="#3A2055" Offset="0"/>
                <GradientStop Color="#1D102B" Offset="0.47"/>
                <GradientStop Color="#090710" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid Margin="38,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="1.10*" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,0,24,0">
                    <Image Source="/Assets/blofy_logo.png" Height="110" Width="180"
                           Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock Text="BLOFY STREAM" FontSize="39" FontWeight="Bold"
                               Foreground="#DFC6FF" Margin="0,12,0,6"/>
                    <TextBlock x:Name="WelcomeTitle" Text="عالم الترفيه بكود واحد"
                               FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock x:Name="WelcomeHint"
                               Text="تطبيق مستقل لويندوز، بنفس حسابات وأكواد BLOFY STREAM. بدون كتابة هوست أو اسم مستخدم أو كلمة مرور."
                               TextWrapping="Wrap" FontSize="15" Foreground="#D4C8DF"
                               LineHeight="26" Margin="0,15,14,0"/>
                    <Border Background="#3A2749" BorderBrush="#76568C"
                            BorderThickness="1" CornerRadius="15" Padding="16" Margin="0,28,20,0">
                        <StackPanel>
                            <TextBlock x:Name="Feature1" Text="✓  القنوات المباشرة، الأفلام، المسلسلات"
                                       FontSize="14" Margin="0,0,0,12"/>
                            <TextBlock x:Name="Feature2" Text="✓  مشغل LibVLC للشاشات الكبيرة"
                                       FontSize="14" Margin="0,0,0,12"/>
                            <TextBlock x:Name="Feature3" Text="✓  المفضلة والبحث ومتابعة المشاهدة"
                                       FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="1" Width="440" HorizontalAlignment="Center"
                        CornerRadius="26" BorderBrush="#73518C" BorderThickness="1"
                        Background="#E6181224" Padding="32" VerticalAlignment="Center">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,12">
                            <TextBlock Text="BLOFY • WINDOWS" FontSize="12"
                                       Foreground="#C99FFF" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="LanguageButton" Content="English"
                                    DockPanel.Dock="Right" Background="Transparent" Foreground="#F4EAFF"
                                    BorderBrush="#7A5D93" Click="Language_Click" Padding="12,7"/>
                        </DockPanel>
                        <TextBlock x:Name="CodeTitle" Text="أدخل كود الاشتراك"
                                   FontSize="26" FontWeight="Bold" Margin="0,6,0,8"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CodeHint" Text="الكود الرقمي من لوحة BLOFY STREAM"
                                   TextAlignment="Center" Foreground="#BDB0CD" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <TextBox x:Name="CodeInput" MaxLength="24" FontSize="25"
                                 FontWeight="Bold" FontFamily="Consolas"
                                 FlowDirection="LeftToRight" TextAlignment="Center"
                                 Padding="9,12" Background="#100D19" Foreground="White"
                                 CaretBrush="#D5B6FF" BorderBrush="#A578D5"
                                 BorderThickness="2" MinHeight="68"
                                 PreviewKeyDown="Code_PreviewKeyDown"/>
                        <Button x:Name="ActivateButton" Content="تفعيل الاشتراك"
                                Click="Activate_Click" Style="{StaticResource StreamButton}"
                                Margin="0,15,0,0"/>
                        <TextBlock x:Name="StatusText" Foreground="#DCC8F2"
                                   Text="الاشتراك يبدأ من أول تفعيل ناجح"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,23,0,12" FontSize="13"/>
                        <Button x:Name="RetryButton" Content="إعادة التحقق من الاشتراك"
                                Click="Retry_Click" Visibility="Collapsed"
                                Background="#342642" BorderBrush="#8966A3" Foreground="White"
                                Padding="12,9"/>
                        <TextBlock x:Name="SecureText"
                                   Text="اتصال آمن • بدون حفظ بيانات مصادر البث"
                                   TextAlignment="Center" Foreground="#A891C4"
                                   FontSize="12" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>