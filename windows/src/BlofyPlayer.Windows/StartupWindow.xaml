<Window x:Class="BlofyPlayer.Windows.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BLOFY PLAYER"
        Width="1180" Height="720"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#08060D"
        Foreground="#F3F4F6"
        FlowDirection="RightToLeft"
        ResizeMode="CanResize">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.82,0.15" GradientOrigin="0.82,0.15" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#2B1247" Offset="0"/>
                <GradientStop Color="#100A18" Offset="0.38"/>
                <GradientStop Color="#08060D" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid x:Name="ActivationPanel" Margin="42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="30,0,58,0">
                <Image Source="/Assets/blofy_logo.png" Width="170" Height="92"
                       Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,0,18"/>
                <TextBlock Text="BLOFY PLAYER" FontSize="38" FontWeight="Bold"/>
                <TextBlock Text="اربط جهازك وابدأ المشاهدة"
                           FontSize="24" FontWeight="SemiBold" Margin="0,10,0,12"/>
                <TextBlock Text="امسح الباركود بالجوال أو افتح بوابة BLOFY. بعد نجاح التفعيل اضغط «دخول BLOFY»، وبعدها نجهز قوائمك ونفتح التطبيق."
                           Foreground="#C9BCD9" FontSize="15" LineHeight="26" TextWrapping="Wrap" MaxWidth="520"/>

                <Border Background="#161020" BorderBrush="#55376C" BorderThickness="1"
                        CornerRadius="18" Padding="18" Margin="0,26,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="رقم الجهاز" Foreground="#AFA4BC" FontSize="12"/>
                            <TextBlock x:Name="DeviceIdText" FontSize="21" FontWeight="Bold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="#3F2B51" Margin="8,0"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رمز الربط" Foreground="#AFA4BC" FontSize="12"/>
                            <TextBlock x:Name="ActivationCodeText" FontSize="26" FontWeight="Bold"
                                       Foreground="#D0B2FF" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#120D1B" BorderBrush="#3F2B51" BorderThickness="1"
                        CornerRadius="14" Padding="15" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ActivationStateText" Text="جاري التحقق من حالة الجهاز…"
                                   Foreground="#D0B2FF" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="TrialText" Foreground="#BFB3CD" FontSize="12"
                                   Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="EnterButton" Content="دخول BLOFY" IsEnabled="False"
                            Click="EnterButton_Click" Background="#D0B2FF" Foreground="#08060D"
                            FontWeight="Bold" FontSize="15" Padding="26,12" BorderThickness="0"
                            MinWidth="155" Cursor="Hand"/>
                    <Button Content="تحديث من الموقع" Click="RefreshButton_Click"
                            Background="#241536" Foreground="#F3F4F6" BorderBrush="#5B4373"
                            BorderThickness="1" Padding="20,12" Margin="10,0,0,0" Cursor="Hand"/>
                    <Button Content="فتح الموقع" Click="OpenPortalButton_Click"
                            Background="Transparent" Foreground="#D0B2FF" BorderBrush="#5B4373"
                            BorderThickness="1" Padding="20,12" Margin="10,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Width="390" Height="520" VerticalAlignment="Center"
                    Background="#15101F" BorderBrush="#664B80" BorderThickness="1"
                    CornerRadius="28" Padding="28">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="SCAN TO CONNECT" Foreground="#C69BFF" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="امسح الباركود" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,8,0,18"/>
                    <Border Background="White" CornerRadius="18" Padding="12" Width="270" Height="270">
                        <Image x:Name="QrImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="BLOFY PLAYER" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock Text="التفعيل • التجديد • إدارة القوائم"
                               Foreground="#AFA4BC" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="نفس بوابة BLOFY المستخدمة في أندرويد"
                               Foreground="#7F718D" FontSize="11" HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="LoadingPanel" Visibility="Collapsed" Margin="70">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="620">
                <Image Source="/Assets/blofy_logo.png" Width="180" Height="100" Stretch="Uniform"/>
                <TextBlock Text="BLOFY PLAYER" FontSize="31" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="LoadingTitle" Text="جاري تجهيز BLOFY…"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock x:Name="LoadingStatus" Text="التحقق من الجهاز"
                           Foreground="#C9BCD9" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,22"/>
                <ProgressBar x:Name="LoadingProgress" Minimum="0" Maximum="100" Value="5"
                             Height="10" Width="520" Foreground="#B96CFF" Background="#241536"/>
                <TextBlock x:Name="LoadingPercent" Text="5%" Foreground="#D0B2FF"
                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <Button x:Name="BackButton" Content="العودة للتفعيل" Visibility="Collapsed"
                        Click="BackButton_Click" Background="#241536" Foreground="White"
                        BorderBrush="#5B4373" BorderThickness="1" Padding="20,10"
                        HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>