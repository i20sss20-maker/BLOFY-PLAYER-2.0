# Copy to .env on the Azure VM. Never commit the real file.
AZURE_FQDN=blofy-staging.uaenorth.cloudapp.azure.com

POSTGRES_DB=blofy
POSTGRES_USER=blofy
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# At least 24 random characters.
BLOFY_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN

# Exactly 64 hexadecimal characters. Generate with: openssl rand -hex 32
BLOFY_PLAYLIST_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

BLOFY_TRIAL_DAYS=7
