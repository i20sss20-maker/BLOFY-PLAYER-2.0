(blofy_security) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        -Server
    }
}

# Canonical public website and customer portal.
blofyplayer.com {
    import blofy_security
    reverse_proxy activation:8080
}

# Never split SEO/cookies between apex and www.
www.blofyplayer.com {
    import blofy_security
    redir https://blofyplayer.com{uri} permanent
}

# Stable API hostname for Android/iOS. It intentionally reaches the same tested backend during
# phase 1 so moving hosting providers later does not force another API rewrite in the apps.
api.blofyplayer.com {
    import blofy_security
    reverse_proxy activation:8080
}

# Admin gets an isolated origin/cookie boundary. The application keeps its own admin/session auth.
admin.blofyplayer.com {
    import blofy_security
    @root path /
    redir @root /admin 302
    reverse_proxy activation:8080
}

# Until the release service is moved from Railway to this Azure host, keep the official BLOFY
# downloads hostname stable and redirect it to the already verified HTTPS release service.
downloads.blofyplayer.com {
    import blofy_security
    redir https://blofy-update-distribution-production.up.railway.app{uri} 307
}
