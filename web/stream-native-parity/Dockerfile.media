FROM oven/bun:1-debian
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY media-worker.ts /app/media-worker.ts
COPY live-source-continuity.mjs /app/live-source-continuity.mjs
COPY stream-media-file.mjs /app/stream-media-file.mjs
COPY web-media-admission.mjs /app/web-media-admission.mjs
COPY media-ended-drain-fix.mjs /app/
COPY qa/live-finished-drain.test.mjs /app/qa/
RUN bun run media-ended-drain-fix.mjs && bun test qa/live-finished-drain.test.mjs
RUN bun build /app/media-worker.ts --target=bun --outfile=/tmp/media-worker-check.js && rm /tmp/media-worker-check.js
ENV PORT=8080
EXPOSE 8080
USER bun
CMD ["bun","run","/app/media-worker.ts"]
