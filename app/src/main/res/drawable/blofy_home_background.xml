<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#04040A"
                android:centerColor="#07060F"
                android:endColor="#05050C" />
        </shape>
    </item>
    <item android:gravity="bottom|right" android:width="620dp" android:height="620dp">
        <shape android:shape="oval">
            <solid android:color="#107C2BFF" />
        </shape>
    </item>
</layer-list>
