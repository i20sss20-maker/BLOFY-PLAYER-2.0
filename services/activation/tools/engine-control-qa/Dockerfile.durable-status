FROM node:22-bookworm-slim AS lease-test
RUN apt-get update && apt-get install -y --no-install-recommends python3 openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /test
COPY services/activation/src/blofy-live-worker-lease.mjs services/activation/src/blofy-live-feed-proof.mjs ./src/
COPY services/activation/tools/engine-control-qa/lease-wire.test.mjs services/activation/tools/engine-control-qa/lease-wire-check.py ./tools/engine-control-qa/
COPY services/activation/tools/blofy-live-lease-guard.py ./blofy_live_lease_guard.py
COPY services/activation/tools/blofy-live-lease-agent.py services/activation/tools/blofy-live-feed-proof-worker.py ./
COPY services/activation/tools/engine-control-qa/feed-proof-wire.test.mjs ./tools/engine-control-qa/
COPY services/activation/tools/blofy-live-lease-guard.py ./tools/blofy_live_lease_guard.py
COPY services/activation/tools/live_runtime_leased_candidate.py ./
COPY services/activation/tools/engine-control-qa/live-lease-guard.test.py ./engine-control-qa/
RUN python3 -m py_compile blofy_live_lease_guard.py live_runtime_leased_candidate.py && ln -s blofy_live_lease_guard.py blofy-live-lease-guard.py && python3 engine-control-qa/live-lease-guard.test.py && python3 -m py_compile blofy-live-lease-agent.py && node --test tools/engine-control-qa/lease-wire.test.mjs && python3 -m py_compile blofy-live-feed-proof-worker.py && node --test tools/engine-control-qa/feed-proof-wire.test.mjs && touch /test/lease-test-pass
FROM node:22-bookworm-slim
COPY --from=lease-test /test/lease-test-pass /tmp/lease-test-pass
WORKDIR /app
COPY services/activation/src/blofy-engine-status-command.mjs services/activation/src/blofy-engine-status-response.mjs services/activation/src/blofy-engine-durable-status.mjs services/activation/src/blofy-bounded-pilot-permit.mjs services/activation/src/blofy-live-worker-lease.mjs services/activation/src/blofy-live-feed-proof.mjs services/activation/src/blofy-live-feed-proof-inbox.mjs services/activation/src/blofy-live-lease-poll.mjs services/activation/src/blofy-live-feed-proof-transport.mjs ./src/
COPY services/activation/tools/engine-control-qa/durable-status.mjs services/activation/tools/engine-control-qa/durable-status.test.mjs services/activation/tools/engine-control-qa/bounded-pilot.test.mjs services/activation/tools/engine-control-qa/live-worker-lease.test.mjs services/activation/tools/engine-control-qa/live-feed-proof.test.mjs services/activation/tools/engine-control-qa/live-lease-poll.test.mjs services/activation/tools/engine-control-qa/feed-proof-transport.test.mjs ./tools/engine-control-qa/
COPY services/activation/tools/blofy-bounded-pilot-worker.py services/activation/tools/blofy-live-lease-agent.py services/activation/tools/live_runtime_leased_candidate.py services/activation/tools/blofy-live-feed-proof-worker.py ./tools/
COPY services/activation/tools/blofy-live-lease-guard.py ./tools/blofy_live_lease_guard.py
RUN node --test tools/engine-control-qa/durable-status.test.mjs tools/engine-control-qa/bounded-pilot.test.mjs tools/engine-control-qa/live-worker-lease.test.mjs tools/engine-control-qa/live-feed-proof.test.mjs tools/engine-control-qa/live-lease-poll.test.mjs tools/engine-control-qa/feed-proof-transport.test.mjs
CMD ["node","tools/engine-control-qa/durable-status.mjs"]
