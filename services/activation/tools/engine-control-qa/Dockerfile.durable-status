FROM python:3.12-slim AS lease-test
WORKDIR /test
COPY services/activation/tools/blofy-live-lease-guard.py services/activation/tools/live_runtime_leased_candidate.py ./
COPY services/activation/tools/engine-control-qa/live-lease-guard.test.py ./engine-control-qa/
RUN python -m py_compile blofy-live-lease-guard.py live_runtime_leased_candidate.py && python engine-control-qa/live-lease-guard.test.py && touch /test/lease-test-pass
FROM node:22-bookworm-slim
COPY --from=lease-test /test/lease-test-pass /tmp/lease-test-pass
WORKDIR /app
COPY services/activation/src/blofy-engine-status-command.mjs services/activation/src/blofy-engine-status-response.mjs services/activation/src/blofy-engine-durable-status.mjs services/activation/src/blofy-bounded-pilot-permit.mjs services/activation/src/blofy-live-worker-lease.mjs ./src/
COPY services/activation/tools/engine-control-qa/durable-status.mjs services/activation/tools/engine-control-qa/durable-status.test.mjs services/activation/tools/engine-control-qa/bounded-pilot.test.mjs services/activation/tools/engine-control-qa/live-worker-lease.test.mjs ./tools/engine-control-qa/
COPY services/activation/tools/blofy-bounded-pilot-worker.py ./tools/
RUN node --test tools/engine-control-qa/durable-status.test.mjs tools/engine-control-qa/bounded-pilot.test.mjs tools/engine-control-qa/live-worker-lease.test.mjs
CMD ["node","tools/engine-control-qa/durable-status.mjs"]
