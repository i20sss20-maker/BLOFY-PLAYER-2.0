FROM node:22-bookworm-slim
WORKDIR /app
COPY services/activation/src/blofy-engine-status-response.mjs services/activation/src/blofy-engine-synthetic-handoff-qa.mjs ./src/
COPY services/activation/tools/engine-control-qa/handoff.mjs ./tools/engine-control-qa/handoff.mjs
USER node
CMD ["node","tools/engine-control-qa/handoff.mjs"]
