# PostgreSQL connection string supplied by Railway/Postgres
DATABASE_URL=postgresql://user:password@host:5432/db

# Generate a long random secret; never commit the real value
BLOFY_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Default BLOFY trial period
BLOFY_TRIAL_DAYS=7

# Railway usually injects PORT automatically
PORT=8080

# Set to disable only for trusted local development if needed
# PGSSLMODE=disable
