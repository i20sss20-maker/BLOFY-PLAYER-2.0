# PostgreSQL connection string supplied by the Vercel/Neon integration.
# Neon can expose multiple generated keys; this service reads DATABASE_URL exactly.
DATABASE_URL=postgresql://user:password@host:5432/db

# Generate a long random secret; never commit the real value
BLOFY_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Stable 32-byte AES key encoded as exactly 64 hexadecimal characters.
# Generate once for production, back it up securely, and never rotate it casually.
BLOFY_PLAYLIST_ENCRYPTION_KEY=replace-with-64-hex-characters

# Private upstream host for "مشتركين BLOFY".
# Configure the real value only in Railway/Vercel environment settings; never commit it.
BLOFY_SUBSCRIBER_HOST=

# Optional encrypted proxy-session lifetime. Default: 30 days; max enforced: 90 days.
BLOFY_SUBSCRIBER_SESSION_TTL_MS=2592000000

# Default BLOFY trial period
BLOFY_TRIAL_DAYS=7

# Pairing protection defaults: 5 failed codes lock a device for 15 minutes.
# Keep these conservative in production; request limits are per minute.
BLOFY_AUTH_IP_RATE_LIMIT=60
BLOFY_AUTH_DEVICE_RATE_LIMIT=20
BLOFY_AUTH_MAX_FAILURES=5
BLOFY_AUTH_FAILURE_WINDOW_MS=900000
BLOFY_AUTH_LOCK_MS=900000

# Local Docker/Node development only. Do not configure PORT manually in Vercel.
PORT=8080

# Leave unset for Neon/Vercel. Disable TLS only for trusted local development.
# PGSSLMODE=disable


# Tap Payments. Keep TAP_SECRET_KEY server-side only.
# Use sk_test_... in sandbox and sk_live_... only after production approval.
TAP_SECRET_KEY=
# Optional. Set only if Tap requires an explicit merchant id for this account.
TAP_MERCHANT_ID=
# Public HTTPS origin used for Tap webhook and redirect callbacks.
BLOFY_PAYMENT_BASE_URL=https://api.blofyplayer.com
# Production plans are configured in Railway after live approval. Amounts use minor units (SAR halalas).
# Example only — replace with the approved BLOFY PLAYER durations/prices before enabling live payments.
BLOFY_PAYMENT_PLANS_JSON=


# Zid / BLOFY SAT checkout integration.
# The customer pays in the BLOFY SAT Zid store; paid-order webhooks extend the BLOFY PLAYER device automatically.
BLOFY_ZID_STORE_URL=https://blofy-sat.zid.store
# JSON array mapping Zid products to BLOFY PLAYER durations.
# Each item needs planKey, name, durationDays and at least productId or sku. productUrl is shown on /pay.
BLOFY_ZID_PRODUCTS_JSON=
# Configure these exact credentials on the Zid order.payment_status.update webhook.
ZID_WEBHOOK_USERNAME=
ZID_WEBHOOK_PASSWORD=
